{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tidbits/tidbit",
	"version": "0.1.0",
	"title": "Tidbits",
	"category": "text",
	"keywords": [ "tidbits", "tips", "tricks", "insights", "terms", "definitions", "glossary", "facts", "fun facts", "quick tips", "short insights" ],
	"description": "Display hand-picked Tidbit posts in a variety of layouts.",
	"example": {
		"viewportWidth": 480,
		"attributes": {
			"displayMode": "accordion"
		},
		"innerBlocks": [
			{ "name": "tidbits/morsel" },
			{ "name": "tidbits/morsel" },
			{ "name": "tidbits/morsel" }
		]
	},
	"attributes": {
		"displayMode": {
			"type": "string",
			"default": "accordion",
			"enum": [ "accordion", "stacked", "columns" ]
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"dividerBorder": {
			"type": "object",
			"default": {}
		},
		"itemPadding": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"tidbits/displayMode": "displayMode",
		"tidbits/dividerBorder": "dividerBorder",
		"tidbits/itemPadding": "itemPadding"
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"layout": {
			"allowEditing": false
		},
        "color": {
            "background": true,
            "gradients": true,
            "__experimentalDefaultControls": {
                "background": true
            }
        },
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		},
        "__experimentalBorder": {
            "color": true,
            "width": true,
            "style": true,
            "__experimentalDefaultControls": {
                "color": true,
                "width": true,
                "style": true
            }
        }
	},
    "selectors": {
        "root": ".tidbits",
        "color": {
            "background": ".tidbits"
        },
        "border": ".tidbits",
        "spacing": {
            "padding": ".tidbits",
            "margin": ".tidbits"
        }
    },
	"textdomain": "tidbits",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
